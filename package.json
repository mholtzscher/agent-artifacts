{
  "name": "agent-artifacts",
  "version": "0.0.0",
  "description": "A public artifact feed for documents generated by coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "<PLACEHOLDER>"
  },
  "type": "module",
  "scripts": {
    "agent-validate": "bash scripts/agent-validate.sh",
    "dev:cloudflare": "alchemy dev --stage local alchemy.run.ts",
    "dev:e2e": "bun test/e2e/server.ts",
    "deploy:staging": "alchemy deploy --stage staging alchemy.run.ts",
    "deploy:production": "alchemy deploy --stage production alchemy.run.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "prepare": "vp config"
  },
  "dependencies": {
    "alchemy": "^2.0.0-beta.55",
    "effect": "4.0.0-beta.83",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260615.1",
    "@effect/language-service": "latest",
    "@effect/platform-bun": "4.0.0-beta.83",
    "@effect/platform-node": "4.0.0-beta.83",
    "@effect/vitest": "4.0.0-beta.83",
    "@playwright/test": "^1.61.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.2",
    "miniflare": "^4.20260616.0",
    "typescript": "^6.0.3",
    "vite-plus": "latest"
  },
  "packageManager": "bun@1.3.13"
}
