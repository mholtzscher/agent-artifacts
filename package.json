{
  "name": "agent-artifacts",
  "version": "0.0.0",
  "description": "A public artifact feed for documents generated by coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "<PLACEHOLDER>"
  },
  "type": "module",
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "lint": "oxlint src test",
    "lint-fix": "bun run lint --fix",
    "start": "bun src/Program.ts",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0-beta.83",
    "@effect/platform-bun": "4.0.0-beta.83",
    "@effect/sql-sqlite-bun": "4.0.0-beta.83",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "effect": "4.0.0-beta.83",
    "markdown-it": "^14.2.0"
  },
  "devDependencies": {
    "@effect/language-service": "latest",
    "@effect/vitest": "4.0.0-beta.83",
    "@types/bun": "^1.3.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.2",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.3.13"
}
